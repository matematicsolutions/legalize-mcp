            "last_updated": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "law_id": {
              "description": "Official identifier (the .md filename stem).",
              "type": "string"
            },
            "publication_date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "rank": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Country-specific legal text type."
            },
            "sha": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Git commit SHA if a historical version was requested."
            },
            "source_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Official source URL (frontmatter `source`)."
            },
            "status": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "in_force | repealed | ..."
            },
            "title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "country",
            "law_id",
            "github_url",
            "content"
          ],
          "type": "object"
        }
      },
      "sha256": "427ae2e05e0ae9519969a4ba364aef1c6ca0658c86c148b99be23e412c7d38a3"
    },
